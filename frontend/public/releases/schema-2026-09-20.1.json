{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancientlens.org/releases/schema-2026-09-20.1.json",
  "title": "AncientLens curated collection",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "accession",
      "collection",
      "culture",
      "date",
      "description",
      "id",
      "image",
      "image_changes",
      "image_license",
      "image_rights_url",
      "image_sha256",
      "image_url",
      "institution",
      "language",
      "metadata_sha256",
      "metadata_url",
      "note",
      "passages",
      "record_url",
      "retrieved_at",
      "review",
      "source_language",
      "source_snapshot",
      "source_url",
      "text_changes",
      "text_license",
      "text_rights_url",
      "title"
    ],
    "properties": {
      "text_rights_url": {
        "type": "string"
      },
      "id": {
        "type": "string"
      },
      "record_url": {
        "type": "string"
      },
      "source_url": {
        "type": "string"
      },
      "accession": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "text_license": {
        "type": "string"
      },
      "metadata_sha256": {
        "type": "string"
      },
      "image_sha256": {
        "type": "string"
      },
      "institution": {
        "type": "string"
      },
      "date": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "retrieved_at": {
        "type": "string"
      },
      "note": {
        "type": "string"
      },
      "text_changes": {
        "type": "string"
      },
      "review": {
        "const": "unreviewed"
      },
      "metadata_url": {
        "type": "string"
      },
      "image_changes": {
        "type": "string"
      },
      "source_snapshot": {
        "type": "string"
      },
      "image_url": {
        "type": "string"
      },
      "image_license": {
        "type": "string"
      },
      "image_rights_url": {
        "type": "string"
      },
      "source_language": {
        "type": "string"
      },
      "image": {
        "type": "string"
      },
      "language": {
        "type": "string"
      },
      "collection": {
        "type": "string"
      },
      "culture": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "passages": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "field",
            "text",
            "source_text",
            "remark"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "source_text": {
              "type": "string"
            },
            "remark": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
